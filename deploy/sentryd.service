[Unit]
Description=sentryd — Lightweight SOC Agent
Documentation=https://github.com/w01f/logsentry/sentryd
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/sentryd

ExecStart=/usr/local/bin/sentryd daemon

# Config
Environment=SENTRYD_CONFIG=/etc/sentryd/sentryd.yaml

# Restart
Restart=on-failure
RestartSec=5

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_ADMIN CAP_SYS_ADMIN
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_ADMIN CAP_SYS_ADMIN

# Logging
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
