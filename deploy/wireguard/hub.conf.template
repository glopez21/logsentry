# WireGuard hub configuration
# Replace variables before deploying:
#   HUB_PRIVATE_KEY — generate with: wg genkey
#   HUB_PUBLIC_KEY  — derive with: wg pubkey < private.key
#   HUB_WAN_INTERFACE — the hub's public network interface (e.g., eth0)
#   AGENT_PUBLIC_KEY_x — each agent's public key
#   AGENT_TUN_IP_x — each agent's mesh IP (e.g., 10.200.0.x)
#   OVERLAY_SUBNET — the overlay network (e.g., 10.200.0.0/24)
#
# Auto-generated by: deploy/install-wireguard-hub.sh

[Interface]
Address = ${OVERLAY_GATEWAY:-10.200.0.1}/24
ListenPort = ${WG_PORT:-51820}
PrivateKey = ${HUB_PRIVATE_KEY}

# Enable IP forwarding for overlay-to-WAN traffic
PostUp = sysctl -w net.ipv4.ip_forward=1
PostUp = iptables -A FORWARD -i %i -j ACCEPT
PostUp = iptables -A FORWARD -o %i -j ACCEPT
PostUp = iptables -t nat -A POSTROUTING -o ${HUB_WAN_INTERFACE:-eth0} -j MASQUERADE
PostDown = iptables -D FORWARD -i %i -j ACCEPT 2>/dev/null || true
PostDown = iptables -D FORWARD -o %i -j ACCEPT 2>/dev/null || true
PostDown = iptables -t nat -D POSTROUTING -o ${HUB_WAN_INTERFACE:-eth0} -j MASQUERADE 2>/dev/null || true

# ── Agents ─────────────────────────────────────────────────────
# Each [Peer] section defines an agent that can connect.
