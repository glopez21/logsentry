[Unit]
Description=sentryd — Mesh SOC Agent (w3bv01d + sentryd)
Documentation=https://github.com/w01f/logsentry/sentryd
After=network-online.target w3bv01d.service
Wants=network-online.target w3bv01d.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/sentryd

# mesh-discover.py starts w3bv01d peer, discovers hub, then launches sentryd
ExecStart=/opt/sentryd/.venv/bin/python3 /opt/sentryd/scripts/mesh-discover.py \
    --coordinator ws://coordinator.mesh:8765 \
    --hub-peer-id augur-hub \
    --hub-port 8000 \
    /usr/local/bin/sentryd daemon

# Config template (hub.url is overridden by mesh-discover)
Environment=SENTRYD_CONFIG=/etc/sentryd/sentryd.mesh.yaml
Environment=MESH_COORDINATOR=ws://coordinator.mesh:8765
Environment=MESH_HUB_PEER_ID=augur-hub

# Restart
Restart=on-failure
RestartSec=5

# TUN + networking
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_ADMIN CAP_SYS_ADMIN
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_ADMIN CAP_SYS_ADMIN

# Logging
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
