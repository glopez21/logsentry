# LogSentry — Endpoint Configuration
# One file per host. Set Augur and ThreatPulse URLs for your deployment.
# No API keys required — leave AUGUR_API_KEY / THREATPULSE_API_KEY empty
# if the hubs don't require auth.

# Augur SOC Hub (telemetry + alert ingestion)
AUGUR_URL=http://augur:5173
AUGUR_API_KEY=

# ThreatPulse platform (detection events + metrics)
THREATPULSE_URL=http://threatpulse:8080
THREATPULSE_API_KEY=

# Postgres (shared by all hosts)
LOGSENTRY_DSN=postgresql://logsentry:logsentry@localhost:5432/logsentry
